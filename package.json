{
  "name": "nansen-hyperliquid",
  "version": "1.0.0",
  "description": "Hyperliquid perpetual copytrading daemon — discover & track top traders via Nansen API",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node build/index.js",
    "start": "node build/index.js",
    "daemon": "npm run build && node build/daemon.js",
    "test": "NODE_ENV=test node --import tsx --test tests/**/*.test.ts",
    "test:coverage": "NODE_ENV=test c8 node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "keywords": ["nansen", "hyperliquid", "perp", "copytrading", "daemon", "web3"],
  "author": "edycutjong",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/node": "^24.9.1",
    "c8": "^10.1.3",
    "eslint": "^9.38.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
