# Nansen API Key — get yours at https://app.nansen.ai/settings/api
NANSEN_API_KEY=your_api_key_here

# Server port (default: 3001)
PORT=3001

# Daemon polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL=300

# Minimum PnL filter for leaderboard discovery (USD)
MIN_PNL=10000

# Minimum ROI filter for leaderboard discovery (%)
MIN_ROI=20

# Minimum account value filter (USD)
MIN_ACCOUNT_VALUE=50000

# Number of top traders to track
TOP_TRADERS=20

# Cache TTL in seconds (default: 120 = 2 minutes)
CACHE_TTL=120
